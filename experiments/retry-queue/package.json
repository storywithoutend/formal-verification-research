{
  "name": "@storywithoutend/model-first-retry-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:model": "vitest run test/model-based.test.ts",
    "test:otel": "vitest run test/otel-trace.test.ts test/otel-failure-modes.test.ts test/otel-faulty-queues.test.ts test/otel-mutation.test.ts",
    "trace:generate": "tsx src/demo.ts",
    "trace:validate": "tsx src/validate-trace-cli.ts results/good-trace.json",
    "trace:validate-all": "tsx src/validate-fixtures.ts",
    "tlc": "./scripts/run-tlc.sh",
    "apalache": "./scripts/run-apalache.sh",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.2",
    "@effect/platform": "^0.97.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "effect": "3.22.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.10.1",
    "fast-check": "4.10.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
